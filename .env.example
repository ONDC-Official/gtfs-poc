# Compose-level configuration. Copy to .env; compose reads it automatically,
# both for ${...} substitution here and as environment for the api service.
#
# App configuration (the RT feed, retention) normally lives in backend/.env,
# which the api service also reads. This file is loaded AFTER it, so anything
# you uncomment below WINS over backend/.env. That is why the feed settings
# ship commented out - an empty RT_API_KEY here would silently override a
# working key in backend/.env and drop you onto the simulated feed.

# --- ports ---------------------------------------------------------------
WEB_PORT=8080
# The API is reached through nginx; bind it to loopback unless you need it
# directly. Use 0.0.0.0:8000 to expose it, or comment out to keep it internal.
API_PORT=127.0.0.1:8000
# Prometheus (scrapes api:8000/metrics). Loopback by default; widen this only
# if the Grafana instance you're pointing at it lives off this host.
PROMETHEUS_PORT=127.0.0.1:9090

# --- static feed ---------------------------------------------------------
GTFS_STATIC_DIR=./delhi_buses_static_gtfs_v1-2
# Set to 1 for a single run to rebuild the database from the static feed.
GTFS_FORCE_RELOAD=0

# --- realtime feed (uncomment only to override backend/.env) --------------
#RT_API_KEY=
#RT_API_KEY_HEADER=x-api-key
#RT_VEHICLE_POSITIONS_URL=https://dts-backend.transportstack.in/api/dataset/otd/get-file?agency=delhi-buses&category=realtime_gtfs&filename=VehiclePositions.pb
#RT_POLL_SECONDS=30
#HISTORY_RETENTION_HOURS=12
