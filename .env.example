# Compose-level configuration. Copy to .env; compose reads it automatically,
# both for ${...} substitution here and as environment for the api service.
#
# App configuration (the RT feed, retention) normally lives in backend/.env,
# which the api service also reads. This file is loaded AFTER it, so anything
# you uncomment below WINS over backend/.env. That is why the feed settings
# ship commented out - an empty RT_API_KEY here would silently override a
# working key in backend/.env and drop you onto the simulated feed.

# --- ports ---------------------------------------------------------------
WEB_PORT=8080
# The API is reached through nginx; bind it to loopback unless you need it
# directly. Use 0.0.0.0:8000 to expose it, or comment out to keep it internal.
API_PORT=127.0.0.1:8000
# Prometheus (scrapes api:8000/metrics). Loopback by default; widen this only
# if the Grafana instance you're pointing at it lives off this host.
PROMETHEUS_PORT=127.0.0.1:9090

# --- static feed ---------------------------------------------------------
GTFS_STATIC_DIR=./delhi_buses_static_gtfs_v1-2
# Set to 1 for a single run to rebuild the database from the static feed.
GTFS_FORCE_RELOAD=0

# --- realtime feed (uncomment only to override backend/.env) --------------
#RT_API_KEY=
#RT_API_KEY_HEADER=x-api-key
#RT_VEHICLE_POSITIONS_URL=https://dts-backend.transportstack.in/api/dataset/otd/get-file?agency=delhi-buses&category=realtime_gtfs&filename=VehiclePositions.pb
#RT_POLL_SECONDS=30
#HISTORY_RETENTION_HOURS=12

# ---- BMTC collectors (docker compose --profile bmtc) -----------------------
# Token from BMTC's email. Leave commented until you have one: the collector
# refuses to start without it, and nothing else reads these.
# BMTC_AUTH_TOKEN=
# BMTC_POLL_SECONDS=10
# BMTC_RETENTION_HOURS=72
# BMTC_STATIC_EVERY_HOURS=72
# Trip collector (bmtc-trip-collector): zone-wise trip updates + stop_times.
# BMTC_TRIP_POLL_MINUTES=15
# BMTC_STOP_TIMES_EVERY_HOURS=72
# BMTC_MIN_FREE_GB=8

# ---- Perf harness (docker compose --profile harness) -----------------------
# Tests the dev Transit Hub from both sides. See harness/README.md.
# Dev consumer admin key (required to run tests; never commit it).
# HARNESS_ADMIN_API_KEY=
# HARNESS_CONSUMER_URL=https://gtfs-dev.ondc.tech
# Public URL of the mock as the dev collector reaches it.
# HARNESS_MOCK_PUBLIC_URL=https://fis-staging.ondc.org/gtfs/mock-agency
# Token the mock requires until per-agency tokens land (harness G2).
# HARNESS_MOCK_TOKEN=
# HARNESS_MOCK_VEHICLES=7000
# Mock control API, host loopback only.
# HARNESS_CONTROL_PORT=127.0.0.1:19191
# Resource caps (shared host).
# HARNESS_MOCK_CPUS=0.5
# HARNESS_MOCK_MEM=768m
# HARNESS_CPUS=1.0
# HARNESS_MEM=1g
# HARNESS_MAX_MBIT=50
# Infrastructure faults on dev: only "true" during an agreed window.
# HARNESS_FAULTS_ALLOWED=false
