# Delhi Open Transit Data, via the TransportStack gateway.
# This feed authenticates with an x-api-key header, not a query parameter.
RT_API_KEY=
RT_API_KEY_HEADER=x-api-key
RT_VEHICLE_POSITIONS_URL=https://dts-backend.transportstack.in/api/dataset/otd/get-file?agency=delhi-buses&category=realtime_gtfs&filename=VehiclePositions.pb
RT_POLL_SECONDS=30

# If your feed wants the key on the query string instead, clear the header
# name and set the parameter:
# RT_API_KEY_HEADER=
# RT_API_KEY_PARAM=key

HISTORY_RETENTION_HOURS=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
