{
  "title": "GTFS-RT Quality",
  "uid": "gtfs-rt-quality",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "tags": ["gtfs-rt", "quality"],
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Prometheus datasource scraping the GTFS-RT api's /metrics endpoint.",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "templating": { "list": [] },
  "panels": [
    { "id": 1, "type": "stat", "title": "Composite QoS score",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_composite_score", "legendFormat": "score", "refId": "A" }],
      "fieldConfig": { "defaults": {
        "unit": "none", "min": 0, "max": 100,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "orange", "value": 50 }, { "color": "green", "value": 75 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "background" }
    },
    { "id": 2, "type": "stat", "title": "Poll success", "gridPos": { "x": 6, "y": 0, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_poll_success_pct", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [
        { "color": "red", "value": null }, { "color": "orange", "value": 90 }, { "color": "green", "value": 98 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" } },
    { "id": 3, "type": "stat", "title": "Fresh ≤60s", "gridPos": { "x": 10, "y": 0, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_fresh_within_pct{threshold_s=\"60\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [
        { "color": "red", "value": null }, { "color": "orange", "value": 60 }, { "color": "green", "value": 85 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" } },
    { "id": 4, "type": "stat", "title": "Implausible speed", "gridPos": { "x": 14, "y": 0, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_implausible_speed_pct", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 15 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" } },
    { "id": 5, "type": "stat", "title": "Routes dark", "gridPos": { "x": 18, "y": 0, "w": 3, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_routes_dark", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 6, "type": "stat", "title": "Feed volume unstable", "gridPos": { "x": 21, "y": 0, "w": 3, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_feed_volume_unstable", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none", "mappings": [
        { "type": "value", "options": { "0": { "text": "stable", "color": "green" }, "1": { "text": "unstable", "color": "red" } } } ] }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" } },

    { "id": 10, "type": "row", "title": "01 · Coverage — is the data there at all?", "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 11, "type": "timeseries", "title": "Fleet / route / spatial coverage",
      "gridPos": { "x": 0, "y": 6, "w": 14, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "gtfs_quality_fleet_coverage_pct", "legendFormat": "fleet coverage", "refId": "A" },
        { "expr": "gtfs_quality_route_coverage_pct", "legendFormat": "route coverage", "refId": "B" },
        { "expr": "gtfs_quality_spatial_coverage_pct", "legendFormat": "spatial coverage", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 12, "type": "stat", "title": "Busiest dark route (trips)", "gridPos": { "x": 14, "y": 6, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_dark_route_top_trip_count", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 13, "type": "stat", "title": "Spatial cells observed / total", "gridPos": { "x": 19, "y": 6, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "gtfs_quality_spatial_cells_observed", "legendFormat": "observed", "refId": "A" },
        { "expr": "gtfs_quality_spatial_cells_total", "legendFormat": "total", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" } },
    { "id": 14, "type": "bargauge", "title": "Temporal coverage by hour (weekday)",
      "gridPos": { "x": 14, "y": 10, "w": 10, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_temporal_coverage_pct{weekend=\"0\"}", "legendFormat": "{{hour}}h", "instant": true, "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "gradient" } },

    { "id": 20, "type": "row", "title": "02 · Freshness & Latency — how current is the data?", "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 21, "type": "timeseries", "title": "Fresh within N seconds",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_fresh_within_pct", "legendFormat": "≤{{threshold_s}}s", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 22, "type": "timeseries", "title": "Per-vehicle staleness",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_staleness_bucket_count", "legendFormat": "{{bucket}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 23, "type": "timeseries", "title": "Feed age at source & publish cadence",
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "gtfs_quality_feed_age_at_source_seconds", "legendFormat": "feed age at source", "refId": "A" },
        { "expr": "gtfs_quality_native_publish_cadence_seconds", "legendFormat": "native publish cadence", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 24, "type": "timeseries", "title": "Ingest latency",
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_ingest_latency_ms", "legendFormat": "ingest", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } } },

    { "id": 30, "type": "row", "title": "03 · Continuity — does a bus keep reporting without gaps?", "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 31, "type": "timeseries", "title": "Report continuity",
      "gridPos": { "x": 0, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_report_continuity_pct", "legendFormat": "continuity", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "none" } } },
    { "id": 32, "type": "stat", "title": "Trip completeness", "gridPos": { "x": 8, "y": 32, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_trip_completeness_pct", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 33, "type": "stat", "title": "Session churn", "gridPos": { "x": 8, "y": 36, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_session_churn", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 34, "type": "timeseries", "title": "Gap duration distribution",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_gap_duration_bucket_count", "legendFormat": "{{bucket}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },

    { "id": 40, "type": "row", "title": "04 · Correctness — is the data believable?", "gridPos": { "x": 0, "y": 40, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 41, "type": "timeseries", "title": "Implausible speed, off-route, duplicate polls",
      "gridPos": { "x": 0, "y": 41, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "gtfs_quality_implausible_speed_pct", "legendFormat": "implausible speed", "refId": "A" },
        { "expr": "100 - gtfs_quality_off_route_pct_within_50m", "legendFormat": "off-route (>50m)", "refId": "B" },
        { "expr": "gtfs_quality_duplicate_snapshot_pct", "legendFormat": "duplicate polls", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 42, "type": "stat", "title": "Out of bounds", "gridPos": { "x": 12, "y": 41, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_coordinate_out_of_bounds", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 43, "type": "stat", "title": "Zero coordinates", "gridPos": { "x": 18, "y": 41, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_coordinate_zero", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 44, "type": "stat", "title": "Invalid route_id", "gridPos": { "x": 12, "y": 45, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_referential_invalid_route_id", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 45, "type": "stat", "title": "Invalid trip_id", "gridPos": { "x": 18, "y": 45, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_referential_invalid_trip_id", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },

    { "id": 50, "type": "row", "title": "05 · Field Richness — how complete is each record?", "gridPos": { "x": 0, "y": 49, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 51, "type": "bargauge", "title": "Field population rate",
      "gridPos": { "x": 0, "y": 50, "w": 16, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_field_population_pct", "legendFormat": "{{field}}", "instant": true, "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "gradient" } },
    { "id": 52, "type": "stat", "title": "Static feed age", "gridPos": { "x": 16, "y": 50, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_static_feed_age_days", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "d" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 53, "type": "stat", "title": "Static routes / stops / trips", "gridPos": { "x": 16, "y": 54, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "gtfs_quality_static_routes", "legendFormat": "routes", "refId": "A" },
        { "expr": "gtfs_quality_static_stops", "legendFormat": "stops", "refId": "B" },
        { "expr": "gtfs_quality_static_trips", "legendFormat": "trips", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" } },

    { "id": 60, "type": "row", "title": "06 · Source Reliability — is the feed endpoint itself healthy?", "gridPos": { "x": 0, "y": 58, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    { "id": 61, "type": "timeseries", "title": "Poll success rate",
      "gridPos": { "x": 0, "y": 59, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_poll_success_pct", "legendFormat": "success", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "none" } } },
    { "id": 62, "type": "timeseries", "title": "Error breakdown",
      "gridPos": { "x": 12, "y": 59, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_error_breakdown_count", "legendFormat": "{{kind}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 63, "type": "timeseries", "title": "Feed volume (mean / min / max)",
      "gridPos": { "x": 0, "y": 67, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "gtfs_quality_feed_volume_mean", "legendFormat": "mean", "refId": "A" },
        { "expr": "gtfs_quality_feed_volume_min", "legendFormat": "min", "refId": "B" },
        { "expr": "gtfs_quality_feed_volume_max", "legendFormat": "max", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 64, "type": "stat", "title": "Schema fields sent", "gridPos": { "x": 12, "y": 67, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_schema_fields_count", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 65, "type": "stat", "title": "Schema last changed", "gridPos": { "x": 18, "y": 67, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "gtfs_quality_schema_last_changed_timestamp", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "dateTimeFromNow" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } } }
  ]
}
